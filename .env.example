# Required: generate a random URL-safe value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Production semantic model; first use requires downloading Hugging Face weights.
# To run without model downloads, explicitly choose lsa-demo (limited catalog-trained baseline).
EMBEDDING_BACKEND=minilm
# Below variables are for manual backend execution, not needed by Docker Compose.
DATABASE_URL=sqlite:///./careerlens.db
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTO_CREATE_SCHEMA=true
